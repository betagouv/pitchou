{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onagre project preparation v2",
  "type": "object",
  "required": ["formatVersion", "identity", "proposal", "demandes"],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "identity": {
      "type": "object",
      "required": ["sourceInstance", "sourceTable", "sourceId", "key"],
      "additionalProperties": false,
      "properties": {
        "sourceInstance": {
          "const": "onagre-national"
        },
        "sourceTable": {
          "const": "projet"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^onagre-national:projet:[1-9][0-9]*$"
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "omittedDemandes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "demandes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["formatVersion", "identity", "label", "proposal"],
        "properties": {
          "formatVersion": {
            "const": 1
          },
          "label": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 200
          },
          "identity": {
            "type": "object",
            "required": ["sourceInstance", "sourceTable", "sourceId", "projetId", "key"],
            "properties": {
              "sourceInstance": {
                "const": "onagre-national"
              },
              "sourceTable": {
                "enum": ["demandes", "projet"]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "projetId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "key": {
                "type": "string",
                "pattern": "^onagre-national:(demandes:[0-9]+|projet:[1-9][0-9]*:initial-demande)$"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "sourceTable": {
                    "const": "demandes"
                  },
                  "key": {
                    "pattern": "^onagre-national:demandes:[0-9]+$"
                  }
                }
              },
              {
                "properties": {
                  "sourceTable": {
                    "const": "projet"
                  },
                  "key": {
                    "pattern": "^onagre-national:projet:[1-9][0-9]*:initial-demande$"
                  }
                }
              }
            ]
          },
          "proposal": {
            "type": "object",
            "required": ["dossier", "records"],
            "properties": {
              "dossier": {
                "type": "object",
                "required": ["source", "depot_date"],
                "not": {
                  "required": ["name"]
                },
                "properties": {
                  "source": {
                    "const": "onagre"
                  },
                  "depot_date": {
                    "type": "null"
                  }
                }
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "speciesImpacts": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "contacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceKey", "values"],
                  "properties": {
                    "sourceKey": {
                      "type": "string",
                      "pattern": "^onagre-national:[\\w:-]+$"
                    },
                    "values": {
                      "$ref": "#/$defs/personValues"
                    }
                  }
                }
              },
              "porteur": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "values"],
                    "properties": {
                      "type": {
                        "const": "personne_physique"
                      },
                      "values": {
                        "$ref": "#/$defs/personValues"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "siret", "values", "verification"],
                    "properties": {
                      "type": {
                        "const": "personne_morale"
                      },
                      "siret": {
                        "type": "string",
                        "pattern": "^[0-9]{14}$"
                      },
                      "values": {
                        "$ref": "#/$defs/companyValues"
                      },
                      "verification": {
                        "type": "object",
                        "required": ["status", "reason", "sources"],
                        "properties": {
                          "status": {
                            "const": "verified"
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sources": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "pattern": "^https://"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "values"],
                    "properties": {
                      "type": {
                        "const": "organisation"
                      },
                      "values": {
                        "$ref": "#/$defs/organisationValues"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "personValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_names", "last_name", "email", "address", "phone", "role"],
      "properties": {
        "first_names": {
          "type": ["string", "null"]
        },
        "last_name": {
          "type": ["string", "null"]
        },
        "email": {
          "type": ["string", "null"]
        },
        "address": {
          "type": ["string", "null"]
        },
        "phone": {
          "type": ["string", "null"]
        },
        "role": {
          "type": ["string", "null"]
        }
      }
    },
    "companyValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "address", "postal_code", "insee_code"],
      "properties": {
        "legal_name": {
          "type": ["string", "null"]
        },
        "address": {
          "type": ["string", "null"]
        },
        "postal_code": {
          "type": ["string", "null"]
        },
        "insee_code": {
          "type": ["string", "null"]
        }
      }
    },
    "organisationValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "siren",
        "verification_status",
        "source",
        "source_reference",
        "verification_evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "address": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "siren": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{9}$"
        },
        "verification_status": {
          "enum": ["source_declared", "verified"]
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_reference": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification_evidence": {
          "type": ["string", "null"],
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "properties": {
            "verification_status": {
              "const": "source_declared"
            },
            "siren": {
              "type": "null"
            },
            "verification_evidence": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "verification_status": {
              "const": "verified"
            },
            "verification_evidence": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
