{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-inline-comments": "error",
    "eslint/no-negated-condition": "error",
    "eslint/no-else-return": "error",
    "eslint/no-eval": "error",
    "eslint/no-new-func": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-var": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/require-unicode-regexp": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/escape-case": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "promise/no-return-wrap": "error",
    "promise/no-new-statics": "error",
    "promise/param-names": "error",
    "promise/no-multiple-resolved": "error",
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 75,
        "skipComments": true,
        "skipBlankLines": true
      }
    ],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": "allow-with-description",
        "ts-check": false
      }
    ]
  },
  "ignorePatterns": [
    "libs/types/src/database/**",
    "libs/types/src/demarche-numerique/**",
    "docs/style/dsfr/**",
    "**/*.min.js"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.mjs"],
      "plugins": ["typescript", "unicorn", "oxc", "promise", "vitest"],
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/no-identical-title": "error",
        "vitest/valid-describe-callback": "error",
        "vitest/valid-expect": [
          "error",
          {
            "maxArgs": 2
          }
        ],
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expectTracking"]
          }
        ],
        "vitest/no-standalone-expect": [
          "error",
          {
            "additionalTestBlockFunctions": ["afterEach"]
          }
        ],
        "vitest/no-test-return-statement": "error",
        "vitest/no-interpolation-in-snapshots": "error"
      }
    },
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/tests/**",
        "**/*.testHelpers.ts",
        "libs/server/src/database/fakeDatabase.ts",
        "libs/database/migrations/**",
        "libs/database/seeds/**"
      ],
      "rules": {
        "eslint/max-lines-per-function": "off"
      }
    }
  ]
}
